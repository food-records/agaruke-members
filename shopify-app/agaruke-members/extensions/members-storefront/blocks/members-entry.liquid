<div class="agaruke-members-entry" data-agaruke-member-card style="padding: 20px; border: 1px solid rgba(var(--color-foreground), 0.2); border-radius: 8px; margin: 16px 0;">
  <div data-members-unlinked>
    <h2 class="h4" style="margin: 0 0 8px;">LINEポイントカード</h2>
    <p style="margin: 0 0 16px;">LINEでポイントカードを確認して、ご購入に使えます。Shopifyへのログインは後から選べます。</p>
    <a class="button button--secondary" style="max-width: 100%;" href="/apps/members">LINEでポイントカードを使う</a>
  </div>
  <div data-members-linked hidden>
    <h2 class="h4" style="margin: 0 0 8px;">購入特典</h2>
    <p data-members-points role="status"></p>
    <div data-members-coupons></div>
  </div>
</div>
{% schema %}
{"name":"LINEポイントカード","target":"section","settings":[]}
{% endschema %}
