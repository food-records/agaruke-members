<div class="ag-home">
  <section class="ag-about ag-wrap ag-section" aria-labelledby="ag-about-heading" id="ag-about">
    <div class="ag-about-copy">
      <p class="ag-eyebrow">ABOUT AGARUKE</p>
      <h2 id="ag-about-heading" style="font-size: clamp(25px, 3vw, 39px);">{{ 'home_18' | t }}</h2>
      <p>{{ 'home_21' | t }}</p>
      <p>{{ 'home_2_html' | t }}</p>
      <p>{{ 'home_8_html' | t }}</p>
      <a class="ag-text-link" href="#ag-products">{{ 'home_36' | t }} <span aria-hidden="true">↗</span></a>
    </div>
    {% if section.settings.feature_product.featured_image != blank %}
      <div class="ag-about-image">
        {{ section.settings.feature_product.featured_image | image_url: width: 1100 | image_tag: widths: '400, 700, 1100', sizes: '(min-width: 750px) 46vw, 100vw', loading: 'lazy', alt: section.settings.feature_product.title }}
        <p>{{ 'home_25' | t }}</p>
      </div>
    {% endif %}
  </section>

  <section class="ag-how ag-section" aria-labelledby="ag-how-heading" id="ag-how">
    <div class="ag-wrap">
      <p class="ag-eyebrow">HOW TO ENJOY</p>
      <h2 id="ag-how-heading">{{ 'home_10_html' | t }}</h2>
      <ol class="ag-steps">
        <li><span class="ag-step-number">01</span><div class="ag-step-art" aria-hidden="true"><svg viewBox="0 0 120 100" fill="none"><path d="M24 35 60 19l36 16v44L60 95 24 79V35Zm0 0 36 17 36-17M60 52v43M41 27l36 17"/><path d="M60 2v12m-6-9 6 5 6-5m-6 9-6-3m6 3 6-3"/></svg></div><h3>{{ 'home_34' | t }}</h3><p>{{ 'home_13_html' | t }}</p></li>
        <li><span class="ag-step-number">02</span><div class="ag-step-art" aria-hidden="true"><svg viewBox="0 0 120 100" fill="none"><path d="M21 53h78c-3 27-18 37-39 37S24 80 21 53Zm-6 39h90M43 40c-15-12 12-14 0-29m19 29c-15-12 12-14 0-29m19 29c-15-12 12-14 0-29"/></svg></div><h3>{{ 'home_38' | t }}</h3><p>{{ 'home_14_html' | t }}</p></li>
        <li><span class="ag-step-number">03</span><div class="ag-step-art" aria-hidden="true"><svg viewBox="0 0 120 100" fill="none"><ellipse cx="60" cy="59" rx="44" ry="27"/><ellipse cx="60" cy="59" rx="29" ry="17"/><path d="m90 8 3 8 9 3-9 4-3 8-4-8-8-4 8-3 4-8ZM20 12v17M12 20h16"/></svg></div><h3>{{ 'home_30' | t }}</h3><p>{{ 'home_15_html' | t }}</p></li>
      </ol>
    </div>
  </section>

  <section class="ag-products ag-wrap ag-section" id="ag-products" aria-labelledby="ag-products-heading">
    <div class="ag-section-top"><div><p class="ag-eyebrow">OUR MENU</p><h2 id="ag-products-heading">{{ 'home_11_html' | t }}</h2></div><a class="ag-text-link" href="{{ routes.all_products_collection_url }}">{{ 'home_31' | t }} <span aria-hidden="true">↗</span></a></div>
    {% assign ag_product_count = 0 %}
    {% for block in section.blocks %}{% if block.settings.product != blank %}{% assign ag_product_count = ag_product_count | plus: 1 %}{% endif %}{% endfor %}
    <div class="ag-product-grid{% if ag_product_count == 3 %} ag-product-grid--three{% endif %}">
      {% for block in section.blocks %}
        {% assign item = block.settings.product %}
        {% if item != blank %}
          <article class="ag-product" {{ block.shopify_attributes }}>
            <a class="ag-product-image" href="{{ item.url }}" aria-label="{{ item.title | escape }}">
              {% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 1000 | image_tag: widths: '350, 600, 1000', sizes: '(min-width: 990px) 27vw, (min-width: 750px) 45vw, 100vw', loading: 'lazy', alt: item.title }}{% endif %}
            </a>
            <div class="ag-product-copy"><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3><p>{% if request.locale.iso_code == 'en' %}{{ item.description | strip_html | truncate: 140 | escape }}{% else %}{{ block.settings.description | escape }}{% endif %}</p><p class="ag-product-price">{{ item.price | money }}{% if cart.taxes_included %}<span>{{ 'home_37' | t }}</span>{% endif %}</p><a class="ag-button ag-button-small" href="{{ item.url }}">{{ 'home_35' | t }} <span aria-hidden="true">↗</span></a></div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <p class="ag-products-note">{{ 'home_19' | t }}</p>
  </section>

  <section class="ag-moment" aria-labelledby="ag-moment-heading">
    {% if section.settings.moment_product.featured_image != blank %}<div class="ag-moment-image">{{ section.settings.moment_product.featured_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', alt: section.settings.moment_product.title }}</div>{% endif %}
    <div class="ag-moment-copy"><p class="ag-eyebrow">YOUR OWN LITTLE TREAT</p><h2 id="ag-moment-heading">{{ 'home_17_html' | t }}</h2><p>{{ 'home_16_html' | t }}</p><p>{{ 'home_5_html' | t }}</p><p>{{ 'home_12' | t }}</p></div>
  </section>

  <section class="ag-guide ag-wrap ag-section" id="ag-guide" aria-labelledby="ag-guide-heading">
    <div class="ag-guide-intro"><p class="ag-eyebrow">FIRST TIME HERE?</p><h2 id="ag-guide-heading">{{ 'home_32' | t }}</h2><p>{{ 'home_9_html' | t }}</p><a class="ag-text-link" href="{{ section.settings.contact_url }}">{{ 'home_33' | t }} <span aria-hidden="true">↗</span></a></div>
    <div class="ag-faq">
      <details><summary>{{ 'home_24' | t }}<span aria-hidden="true">＋</span></summary><div><p>{{ 'home_4' | t }}</p></div></details>
      <details><summary>{{ 'home_26' | t }}<span aria-hidden="true">＋</span></summary><div><p>{{ 'home_3' | t }}</p></div></details>
      <details><summary>{{ 'home_23' | t }}<span aria-hidden="true">＋</span></summary><div><p>{{ 'home_1' | t }}</p>{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'home_27' | t }}</a>{% endif %}</div></details>
      <details><summary>{{ 'home_20' | t }}<span aria-hidden="true">＋</span></summary><div><p>{{ 'home_6' | t }}</p></div></details>
    </div>
  </section>
  <aside class="ag-line ag-wrap" aria-labelledby="ag-line-heading"><span class="ag-line-mark" aria-hidden="true">LINE</span><div><p class="ag-eyebrow">MEMBERS</p><h2 id="ag-line-heading">{{ 'home_28' | t }}</h2><p>{{ 'home_7_html' | t }}</p></div><a class="ag-text-link" href="{{ routes.root_url }}apps/members">{{ 'home_29' | t }} <span aria-hidden="true">↗</span></a></aside>
  <div class="ag-bottom-cta ag-wrap"><p>{{ 'home_22' | t }}</p><a class="ag-button" href="#ag-products">{{ 'home_36' | t }} <span aria-hidden="true">↗</span></a></div>
</div>
