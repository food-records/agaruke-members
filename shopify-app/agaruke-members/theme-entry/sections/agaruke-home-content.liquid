{% assign ag_craft = section.blocks | where: 'type', 'craft' | first %}
{% assign ag_delivery = section.blocks | where: 'type', 'delivery' | first %}
{% assign ag_about = section.blocks | where: 'type', 'about' | first %}
{% assign ag_how = section.blocks | where: 'type', 'how' | first %}
{% assign ag_step_one = section.blocks | where: 'type', 'step_one' | first %}
{% assign ag_step_two = section.blocks | where: 'type', 'step_two' | first %}
{% assign ag_step_three = section.blocks | where: 'type', 'step_three' | first %}
{% assign ag_menu = section.blocks | where: 'type', 'menu' | first %}
{% assign ag_moment = section.blocks | where: 'type', 'moment' | first %}
{% assign ag_guide = section.blocks | where: 'type', 'guide' | first %}
{% assign ag_members = section.blocks | where: 'type', 'members' | first %}
{% assign ag_bottom = section.blocks | where: 'type', 'bottom' | first %}
<div class="ag-home">
  {% if ag_about != blank %}
  <section class="ag-about ag-wrap ag-section" {{ ag_about.shopify_attributes }} aria-labelledby="ag-about-heading" id="ag-about">
    <div class="ag-about-copy">
      <p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_about.settings, key: 'eyebrow' %}</p>
      <h2 id="ag-about-heading" style="font-size: clamp(25px, 3vw, 39px);">{% render 'agaruke-copy', copy_settings: ag_about.settings, key: 'heading' %}</h2>
      <p>{% render 'agaruke-copy', copy_settings: ag_about.settings, key: 'lead' %}</p>
      <p>{% render 'agaruke-copy', copy_settings: ag_about.settings, key: 'body', desktop_break: true %}</p>
      <p>{% render 'agaruke-copy', copy_settings: ag_about.settings, key: 'closing' %}</p>
      <a class="ag-text-link" href="{{ ag_about.settings.cta_url | default: '#ag-products' }}">{% render 'agaruke-copy', copy_settings: ag_about.settings, key: 'cta' %} <span aria-hidden="true">↗</span></a>
    </div>
    {% assign ag_about_image = ag_about.settings.image | default: section.settings.feature_product.featured_image %}
    {% assign ag_about_alt = ag_about.settings.image_alt %}
    {% if request.locale.iso_code == 'en' %}{% assign ag_about_alt = ag_about.settings.image_alt_en %}{% endif %}
    {% if ag_about.settings.image == blank %}{% assign ag_about_alt = section.settings.feature_product.title %}{% endif %}
    {% if ag_about_image != blank %}
      <div class="ag-about-image">
        {{ ag_about_image | image_url: width: 1100 | image_tag: widths: '400, 700, 1100', sizes: '(min-width: 750px) 46vw, 100vw', loading: 'lazy', alt: ag_about_alt }}
        <p>{% render 'agaruke-copy', copy_settings: ag_about.settings, key: 'caption' %}</p>
      </div>
    {% endif %}
  </section>
  {% endif %}

  {% if ag_menu != blank %}
  <section class="ag-products ag-wrap ag-section" id="ag-products" aria-labelledby="ag-products-heading">
    <div class="ag-section-top" {{ ag_menu.shopify_attributes }}><div><p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_menu.settings, key: 'eyebrow' %}</p><h2 id="ag-products-heading">{% render 'agaruke-copy', copy_settings: ag_menu.settings, key: 'heading', mobile_break: true %}</h2></div><a class="ag-text-link" href="{{ routes.all_products_collection_url }}">{% render 'agaruke-copy', copy_settings: ag_menu.settings, key: 'list_cta' %} <span aria-hidden="true">↗</span></a></div>
    {% assign ag_product_count = 0 %}
    {% for block in section.blocks %}{% if block.settings.product != blank %}{% assign ag_product_count = ag_product_count | plus: 1 %}{% endif %}{% endfor %}
    <div class="ag-product-grid{% if ag_product_count == 3 %} ag-product-grid--three{% endif %}">
      {% for block in section.blocks %}
        {% assign item = block.settings.product %}
        {% if item != blank %}
          <article class="ag-product" {{ block.shopify_attributes }}>
            <a class="ag-product-image" href="{{ item.url }}" aria-label="{{ item.title | escape }}">
              {% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 1000 | image_tag: widths: '350, 600, 1000', sizes: '(min-width: 990px) 27vw, (min-width: 750px) 45vw, 100vw', loading: 'lazy', alt: item.title }}{% endif %}
            </a>
            <div class="ag-product-copy"><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3><p>{% if request.locale.iso_code == 'en' %}{% if block.settings.description_en != blank %}{{ block.settings.description_en | escape | newline_to_br }}{% else %}{{ item.description | replace: '</p>', ' ' | strip_html | truncate: 140 | escape }}{% endif %}{% else %}{{ block.settings.description | escape | newline_to_br }}{% endif %}</p><p class="ag-product-price">{{ item.price | money }}{% if cart.taxes_included %}<span>{% render 'agaruke-copy', copy_settings: ag_menu.settings, key: 'tax_note' %}</span>{% endif %}</p><a class="ag-button ag-button-small" href="{{ item.url }}">{% render 'agaruke-copy', copy_settings: ag_menu.settings, key: 'detail_cta' %} <span aria-hidden="true">↗</span></a></div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <p class="ag-products-note">{% render 'agaruke-copy', copy_settings: ag_menu.settings, key: 'shipping_note' %}</p>
  </section>
  {% endif %}

  {% if ag_craft != blank %}
  <section class="ag-craft ag-section" id="ag-craft" {{ ag_craft.shopify_attributes }} aria-labelledby="ag-craft-heading">
    <div class="ag-wrap">
      <div class="ag-craft-header{% if ag_craft.settings.image != blank %} ag-craft-header--image{% endif %}">
        <div>
          <p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_craft.settings, key: 'eyebrow' %}</p>
          <h2 id="ag-craft-heading">{% render 'agaruke-copy', copy_settings: ag_craft.settings, key: 'heading' %}</h2>
        </div>
        {% if ag_craft.settings.image != blank %}
          {% assign ag_craft_alt = ag_craft.settings.image_alt %}
          {% if request.locale.iso_code == 'en' %}{% assign ag_craft_alt = ag_craft.settings.image_alt_en %}{% endif %}
          <figure class="ag-craft-image">{{ ag_craft.settings.image | image_url: width: 1000 | image_tag: widths: '350, 500, 750, 1000', sizes: '(min-width: 990px) 400px, (min-width: 750px) 40vw, calc(100vw - 44px)', loading: 'lazy', alt: ag_craft_alt }}</figure>
        {% endif %}
      </div>
      <div class="ag-craft-grid">
        {% for number in (1..3) %}
          {% assign title_key = 'reason_' | append: number | append: '_heading' %}
          {% assign body_key = 'reason_' | append: number | append: '_body' %}
          <article class="ag-craft-item">
            <span class="ag-craft-number" aria-hidden="true">0{{ number }}</span>
            <h3>{% render 'agaruke-copy', copy_settings: ag_craft.settings, key: title_key %}</h3>
            <p>{% render 'agaruke-copy', copy_settings: ag_craft.settings, key: body_key %}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if ag_delivery != blank and ag_delivery.settings.show_on_home and ag_delivery.settings.image != blank %}
  <section class="ag-delivery-shell" {{ ag_delivery.shopify_attributes }} aria-labelledby="ag-delivery-heading" id="ag-delivery">
    <div class="ag-delivery ag-wrap ag-section">
      <div class="ag-delivery-image">
        {% assign ag_delivery_alt = ag_delivery.settings.image_alt %}
        {% if request.locale.iso_code == 'en' %}{% assign ag_delivery_alt = ag_delivery.settings.image_alt_en %}{% endif %}
        {{ ag_delivery.settings.image | image_url: width: 1200 | image_tag: widths: '360, 540, 800, 1200', sizes: '(min-width: 990px) 46vw, (min-width: 750px) 48vw, 100vw', loading: 'lazy', alt: ag_delivery_alt }}
      </div>
      <div class="ag-delivery-copy">
        <p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_delivery.settings, key: 'eyebrow' %}</p>
        <h2 id="ag-delivery-heading">{% render 'agaruke-copy', copy_settings: ag_delivery.settings, key: 'heading' %}</h2>
        <p>{% render 'agaruke-copy', copy_settings: ag_delivery.settings, key: 'body' %}</p>
        <p>{% render 'agaruke-copy', copy_settings: ag_delivery.settings, key: 'closing' %}</p>
        <p class="ag-delivery-note">{% render 'agaruke-copy', copy_settings: ag_delivery.settings, key: 'note' %}</p>
      </div>
    </div>
  </section>
  {% endif %}

  {% if ag_how != blank %}
  <section class="ag-how ag-section" {{ ag_how.shopify_attributes }} aria-labelledby="ag-how-heading" id="ag-how">
    <div class="ag-wrap">
      <p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_how.settings, key: 'eyebrow' %}</p>
      <h2 id="ag-how-heading">{% render 'agaruke-copy', copy_settings: ag_how.settings, key: 'heading', mobile_break: true %}</h2>
      <ol class="ag-steps">
        {% if ag_step_one != blank %}<li {{ ag_step_one.shopify_attributes }}><span class="ag-step-number">01</span><div class="ag-step-art" aria-hidden="true"><svg viewBox="0 0 120 100" fill="none" focusable="false"><path d="m22 49 38-18 38 18-38 19-38-19Zm0 0L9 34l36-18 15 15m38 18 13-15-36-18-15 15"/><g transform="rotate(-12 39 40)"><path d="M28 20h22l2 4-1 35-2 4H29l-2-4-1-35 2-4Z" fill="#fffaf1"/><path d="M28 25h22M29 58h20M31 21v3m4-3v3m4-3v3m4-3v3m4-3v3M32 36c4-4 10-4 14 0m-15 7c4 4 10 4 15 0m-13 6h11"/></g><g transform="rotate(5 62 35)"><path d="M51 11h22l2 4-1 39-2 4H52l-2-4-1-39 2-4Z" fill="#fffaf1"/><path d="M51 16h22M52 53h20M54 12v3m4-3v3m4-3v3m4-3v3m4-3v3M55 28c3-3 10-3 14 1l-2 12H55l-2-7 2-6Z"/></g><g transform="rotate(17 85 42)"><path d="M76 23h21l2 4-1 33-2 4H77l-2-4-1-33 2-4Z" fill="#fffaf1"/><path d="M76 28h21M77 59h19M79 24v3m4-3v3m4-3v3m4-3v3m4-3v3M80 38l5-3 5 4-3 5-6 1-3-4Zm8 9 6-3 2 5-5 5-5-2 2-5Z"/></g><path d="m22 49 38 19 38-19v29L60 97 22 78V49Z" fill="#f6f0e5"/><path d="M60 68v29m-38-48-12 14 38 19 12-14m38-19 12 14-38 19-12-14" fill="#f6f0e5"/></svg></div><h3>{% render 'agaruke-copy', copy_settings: ag_step_one.settings, key: 'heading' %}</h3><p>{% render 'agaruke-copy', copy_settings: ag_step_one.settings, key: 'body' %}</p></li>{% endif %}
        {% if ag_step_two != blank %}<li {{ ag_step_two.shopify_attributes }}><span class="ag-step-number">02</span><div class="ag-step-art" aria-hidden="true"><svg viewBox="0 0 120 100" fill="none"><path d="M21 53h78c-3 27-18 37-39 37S24 80 21 53Zm-6 39h90M43 40c-15-12 12-14 0-29m19 29c-15-12 12-14 0-29m19 29c-15-12 12-14 0-29"/></svg></div><h3>{% render 'agaruke-copy', copy_settings: ag_step_two.settings, key: 'heading' %}</h3><p>{% render 'agaruke-copy', copy_settings: ag_step_two.settings, key: 'body' %}</p></li>{% endif %}
        {% if ag_step_three != blank %}<li {{ ag_step_three.shopify_attributes }}><span class="ag-step-number">03</span><div class="ag-step-art" aria-hidden="true"><svg viewBox="0 0 120 100" fill="none"><ellipse cx="60" cy="59" rx="44" ry="27"/><ellipse cx="60" cy="59" rx="29" ry="17"/><path d="m90 8 3 8 9 3-9 4-3 8-4-8-8-4 8-3 4-8ZM20 12v17M12 20h16"/></svg></div><h3>{% render 'agaruke-copy', copy_settings: ag_step_three.settings, key: 'heading' %}</h3><p>{% render 'agaruke-copy', copy_settings: ag_step_three.settings, key: 'body' %}</p></li>{% endif %}
      </ol>
    </div>
  </section>
  {% endif %}

  {% if ag_moment != blank %}
  <section class="ag-moment" {{ ag_moment.shopify_attributes }} aria-labelledby="ag-moment-heading">
    {% if section.settings.moment_product.featured_image != blank %}<div class="ag-moment-image">{{ section.settings.moment_product.featured_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', alt: section.settings.moment_product.title }}</div>{% endif %}
    <div class="ag-moment-copy"><p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_moment.settings, key: 'eyebrow' %}</p><h2 id="ag-moment-heading">{% render 'agaruke-copy', copy_settings: ag_moment.settings, key: 'heading' %}</h2><p>{% render 'agaruke-copy', copy_settings: ag_moment.settings, key: 'body' %}</p><p>{% render 'agaruke-copy', copy_settings: ag_moment.settings, key: 'body_two' %}</p><p>{% render 'agaruke-copy', copy_settings: ag_moment.settings, key: 'closing' %}</p></div>
  </section>
  {% endif %}

  {% if ag_guide != blank %}
  <section class="ag-guide ag-wrap ag-section" id="ag-guide" aria-labelledby="ag-guide-heading">
    <div class="ag-guide-intro" {{ ag_guide.shopify_attributes }}><p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_guide.settings, key: 'eyebrow' %}</p><h2 id="ag-guide-heading">{% render 'agaruke-copy', copy_settings: ag_guide.settings, key: 'heading' %}</h2><p>{% render 'agaruke-copy', copy_settings: ag_guide.settings, key: 'body' %}</p><a class="ag-text-link" href="{{ section.settings.contact_url }}">{% render 'agaruke-copy', copy_settings: ag_guide.settings, key: 'contact_cta' %} <span aria-hidden="true">↗</span></a></div>
    <div class="ag-faq">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <details {{ block.shopify_attributes }}><summary>{% render 'agaruke-copy', copy_settings: block.settings, key: 'question' %}<span aria-hidden="true">＋</span></summary><div><p>{% render 'agaruke-copy', copy_settings: block.settings, key: 'answer' %}</p>{% if block.settings.show_shipping_policy and shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">{% render 'agaruke-copy', copy_settings: block.settings, key: 'shipping_cta' %}</a>{% endif %}</div></details>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endif %}
  {% if ag_members != blank %}
  <aside class="ag-line ag-wrap" {{ ag_members.shopify_attributes }} aria-labelledby="ag-line-heading"><span class="ag-line-mark" aria-hidden="true">LINE</span><div><p class="ag-eyebrow">{% render 'agaruke-copy', copy_settings: ag_members.settings, key: 'eyebrow' %}</p><h2 id="ag-line-heading">{% render 'agaruke-copy', copy_settings: ag_members.settings, key: 'heading' %}</h2><p>{% render 'agaruke-copy', copy_settings: ag_members.settings, key: 'body' %}</p></div><a class="ag-text-link" href="/apps/members">{% render 'agaruke-copy', copy_settings: ag_members.settings, key: 'cta' %} <span aria-hidden="true">↗</span></a></aside>
  {% endif %}
  {% if ag_bottom != blank %}
  <div class="ag-bottom-cta ag-wrap" {{ ag_bottom.shopify_attributes }}><p>{% render 'agaruke-copy', copy_settings: ag_bottom.settings, key: 'body' %}</p><a class="ag-button" href="{{ ag_bottom.settings.cta_url | default: '#ag-products' }}">{% render 'agaruke-copy', copy_settings: ag_bottom.settings, key: 'cta' %} <span aria-hidden="true">↗</span></a></div>
  {% endif %}
</div>
{% schema %}
{
  "name": "AGARUKE サービス紹介",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "文章は各ブロックの日本語・英語欄で編集します。ブロックの表示位置はデザインに合わせて固定され、商品同士・FAQ同士は並べ替えできます。"
    },
    {
      "type": "product",
      "id": "feature_product",
      "label": "サービス紹介の料理写真"
    },
    {
      "type": "product",
      "id": "moment_product",
      "label": "食卓イメージの料理写真"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "お問い合わせ先"
    }
  ],
  "blocks": [
    {
      "type": "craft",
      "name": "おいしさの理由",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "おいしさの理由の画像"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "画像の代替テキスト（日本語）",
          "default": "豚角煮と牛すじ煮込み、ほうれん草を器に盛り付けた食卓。"
        },
        {
          "type": "text",
          "id": "image_alt_en",
          "label": "画像の代替テキスト（英語）",
          "default": "Braised pork belly, stewed beef tendon and spinach plated at the dining table."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "ラベル（日本語）",
          "default": "WHY AGARUKE"
        },
        {
          "type": "text",
          "id": "eyebrow_en",
          "label": "ラベル（英語）",
          "default": "WHY AGARUKE"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "見出し（日本語）",
          "default": "お店のおいしさを、\nあなたの一皿へ。"
        },
        {
          "type": "textarea",
          "id": "heading_en",
          "label": "見出し（英語）",
          "default": "From our kitchen\nto your table."
        },
        {
          "type": "text",
          "id": "reason_1_heading",
          "label": "理由1 見出し（日本語）",
          "default": "お店で人気の味を、冷凍でも。"
        },
        {
          "type": "text",
          "id": "reason_1_heading_en",
          "label": "理由1 見出し（英語）",
          "default": "Restaurant favorites, made for your freezer."
        },
        {
          "type": "textarea",
          "id": "reason_1_body",
          "label": "理由1 説明（日本語）",
          "default": "実店舗で親しまれている人気メニューを、ご自宅でも。料理ごとの持ち味を大切に、冷凍してもおいしさを楽しめるよう工夫を重ねています。"
        },
        {
          "type": "textarea",
          "id": "reason_1_body_en",
          "label": "理由1 説明（英語）",
          "default": "Enjoy popular dishes from our restaurant at home. We adapt each recipe for freezing, with care to preserve the flavors and textures that make it special."
        },
        {
          "type": "text",
          "id": "reason_2_heading",
          "label": "理由2 見出し（日本語）",
          "default": "個別の真空パックで、おいしさを守る。"
        },
        {
          "type": "text",
          "id": "reason_2_heading_en",
          "label": "理由2 見出し（英語）",
          "default": "Individually vacuum-packed to preserve flavor."
        },
        {
          "type": "textarea",
          "id": "reason_2_body",
          "label": "理由2 説明（日本語）",
          "default": "料理や付け合わせを、それぞれ真空パックに。おいしさと冷凍での保存性に配慮し、食べたいときまで大切にお届けします。"
        },
        {
          "type": "textarea",
          "id": "reason_2_body_en",
          "label": "理由2 説明（英語）",
          "default": "Each dish and accompaniment is vacuum-packed separately, with care for flavor and frozen storage, ready for you to enjoy when you choose."
        },
        {
          "type": "text",
          "id": "reason_3_heading",
          "label": "理由3 見出し（日本語）",
          "default": "盛り付けた姿まで、おいしく。"
        },
        {
          "type": "text",
          "id": "reason_3_heading_en",
          "label": "理由3 見出し（英語）",
          "default": "Designed to look as good as it tastes."
        },
        {
          "type": "textarea",
          "id": "reason_3_body",
          "label": "理由3 説明（日本語）",
          "default": "主菜と付け合わせの組み合わせ、彩り、盛り付けたときのバランスまで。お皿の上で一皿が完成するよう、目でも楽しめるおいしさを考えています。"
        },
        {
          "type": "textarea",
          "id": "reason_3_body_en",
          "label": "理由3 説明（英語）",
          "default": "From the main dish and accompaniments to their colors and balance on the plate, every element is considered. Finish it on your favorite plate and enjoy a meal that delights the eyes, too."
        }
      ]
    },
    {
      "type": "about",
      "name": "サービス紹介",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "ABOUTの画像",
          "info": "未設定の場合は紹介用商品の画像を使用します。"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "画像の代替テキスト（日本語）",
          "default": "ミートボールと付け合わせを、お気に入りの器に盛り付けるひととき。"
        },
        {
          "type": "text",
          "id": "image_alt_en",
          "label": "画像の代替テキスト（英語）",
          "default": "Plating meatballs and accompaniments on a favorite dish."
        },
        {
          "type": "paragraph",
          "content": "日本語・英語をそれぞれ編集できます。文章欄の改行は表示にも反映されます。"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "小見出し（日本語）",
          "default": "ABOUT AGARUKE"
        },
        {
          "type": "text",
          "id": "eyebrow_en",
          "label": "小見出し（英語）",
          "default": "ABOUT AGARUKE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "見出し（日本語）",
          "default": "温めて盛り付けるだけの、簡単ミールキット。"
        },
        {
          "type": "text",
          "id": "heading_en",
          "label": "見出し（英語）",
          "default": "Easy meal kits. Just heat and plate."
        },
        {
          "type": "textarea",
          "id": "lead",
          "label": "本文1（日本語）",
          "default": "ココロに栄養を、気分が上がる一皿を。"
        },
        {
          "type": "textarea",
          "id": "lead_en",
          "label": "本文1（英語）",
          "default": "Nourish your soul with a meal that lifts your mood."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "本文2（日本語）",
          "default": "AGARUKEは、温めて盛りつけるだけで楽しめる\n冷凍ミールキットをお届けします。"
        },
        {
          "type": "textarea",
