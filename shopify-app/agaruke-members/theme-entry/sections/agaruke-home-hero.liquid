{% assign ag_hero_alt = section.settings.promise_0 %}{% if request.locale.iso_code == 'en' %}{% assign ag_hero_alt = section.settings.promise_0_en %}{% endif %}
{{ 'agaruke-home-content.css' | asset_url | stylesheet_tag }}
<div class="ag-home">
  <div class="ag-restored-hero">
    {% if section.settings.image != blank %}
      <div class="banner__media ag-restored-photo"{% if section.settings.mobile_image != blank %} style="--ag-mobile-hero-ratio: {{ section.settings.mobile_image.aspect_ratio }};"{% endif %}>
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 390 }} 390w, {{ section.settings.mobile_image | image_url: width: 600 }} 600w, {{ section.settings.mobile_image | image_url: width: 900 }} 900w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw" width="{{ section.settings.mobile_image.width }}" height="{{ section.settings.mobile_image.height }}">
          {% endif %}
        {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1300, 1600, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ag_hero_alt }}
        </picture>
      </div>
    {% endif %}
    <a class="ag-hero-cta" href="{{ section.settings.cta_url | default: '#ag-products' }}">
      <span>{% render 'agaruke-copy', copy_settings: section.settings, key: 'cta_label' %}</span>
      <svg width="56" height="14" viewBox="0 0 56 14" fill="none" aria-hidden="true"><path d="M1 7h52m-5-4 5 4-5 4" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
  <div class="ag-promise-bar" aria-label="{% render 'agaruke-copy', copy_settings: section.settings, key: 'promise_1' %}">
    <p><svg class="ag-promise-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M3.34 7l17.32 10M3.34 17L20.66 7M9 4l3 3 3-3M9 20l3-3 3 3M4 10l4-1-1-4M20 14l-4 1 1 4M4 14l4 1-1 4M20 10l-4-1 1-4"/></svg> {% render 'agaruke-copy', copy_settings: section.settings, key: 'promise_2' %}</p>
    <p><svg class="ag-promise-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg> {% render 'agaruke-copy', copy_settings: section.settings, key: 'promise_3' %}</p>
    <p><svg class="ag-promise-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg> {% render 'agaruke-copy', copy_settings: section.settings, key: 'promise_4' %}</p>
  </div>
</div>
{% schema %}
{
  "name": "AGARUKE メインビジュアル",
  "tag": "section",
  "class": "ag-hero-section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "料理バナー画像"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "スマートフォン用画像（749px以下）",
      "info": "未設定時は料理バナー画像を使用します。"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTAのテキスト（日本語）",
      "default": "VIEW ITEM"
    },
    {
      "type": "text",
      "id": "cta_label_en",
      "label": "CTAのテキスト（英語）",
      "default": "VIEW ITEM"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTAリンク先（空欄なら商品エリア）"
    },
    {
      "type": "text",
      "id": "promise_0",
      "label": "画像の代替テキスト（日本語）",
      "default": "AGARUKE 気分があがる一皿。"
    },
    {
      "type": "text",
      "id": "promise_0_en",
      "label": "画像の代替テキスト（英語）",
      "default": "AGARUKE — a meal to lift your mood."
    },
    {
      "type": "text",
      "id": "promise_1",
      "label": "案内欄の読み上げ名（日本語）",
      "default": "AGARUKEのお届けと楽しみ方"
    },
    {
      "type": "text",
      "id": "promise_1_en",
      "label": "案内欄の読み上げ名（英語）",
      "default": "Delivery and preparation"
    },
    {
      "type": "text",
      "id": "promise_2",
      "label": "案内①（日本語）",
      "default": "冷凍でお届け"
    },
    {
      "type": "text",
      "id": "promise_2_en",
      "label": "案内①（英語）",
      "default": "Delivered frozen"
    },
    {
      "type": "text",
      "id": "promise_3",
      "label": "案内②（日本語）",
      "default": "温めて、盛りつけ"
    },
    {
      "type": "text",
      "id": "promise_3_en",
      "label": "案内②（英語）",
      "default": "Heat and plate"
    },
    {
      "type": "text",
      "id": "promise_4",
      "label": "案内③（日本語）",
      "default": "自分のための一皿に"
    },
    {
      "type": "text",
      "id": "promise_4_en",
      "label": "案内③（英語）",
      "default": "A moment just for you"
    }
  ],
  "presets": [
    {
      "name": "AGARUKE メインビジュアル"
    }
  ]
}
{% endschema %}
