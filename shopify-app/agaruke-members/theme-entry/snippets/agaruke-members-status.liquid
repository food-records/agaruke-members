{% doc %}
  会員連携の表示状態を短時間保持し、ヘッダー・カートの購入特典を案内する。
{% enddoc %}
{% unless request.design_mode %}
  {%- assign members_legacy_note = false -%}
  {%- assign members_note_key = '獲得予定ポイント（注文全体）' -%}
  {%- for item in cart.items -%}
    {%- if item.properties[members_note_key] != blank -%}
      {%- assign members_legacy_note = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- capture members_cache_scope -%}benefits-live-v1|{{ customer.id }}|{{ cart.token }}|{{ cart.item_count }}|{{ cart.total_price }}|{{ cart.currency.iso_code }}|{{ cart.attributes._agaruke_purchase }}{%- endcapture -%}
  {%- capture members_identity_scope -%}benefits-live-v1|{{ customer.id }}|{% unless customer %}{{ cart.attributes._agaruke_purchase }}{% endunless %}|{{ cart.currency.iso_code }}{%- endcapture -%}
  <script id="agaruke-members-config" type="application/json">{"path":"/apps/members","cache_key":{{ members_cache_scope | sha256 | json }},"identity_key":{{ members_identity_scope | sha256 | json }},"has_cart_session":{% if cart.attributes._agaruke_purchase != blank %}true{% else %}false{% endif %},"legacy_note":{{ members_legacy_note | json }},"customer_present":{% if customer %}true{% else %}false{% endif %},"is_cart":{% if template.name == 'cart' %}true{% else %}false{% endif %}}</script>
  <style>
    html[data-agaruke-benefits-banner="ready"] .shopify-section:has(.announcement-bar a[href*="/apps/members"]) { display: none; }
    html:not([data-agaruke-members-state="unlinked"]) .shopify-section:has(.announcement-bar a[href*="/apps/members"]),
    html:not([data-agaruke-members-state="unlinked"]) .shopify-section:has(.announcement-bar a[href="https://shop.agaruke.com/apps/members"]) { display: none; }
    html[data-agaruke-members-state="linked"] [data-members-unlinked] { display: none; }
    html:not([data-agaruke-members-state]) [data-agaruke-member-card] { visibility: hidden; }
  </style>
  <script>
    try {
      var cfg = JSON.parse(document.getElementById('agaruke-members-config').textContent);
      var cached = JSON.parse(sessionStorage.getItem('agaruke-members-display-v3') || 'null');
      if (cached && cached.version === 3 && (cached.key === cfg.cache_key || cached.identity_key === cfg.identity_key) && Number.isFinite(cached.at) && Date.now() >= cached.at && Date.now() - cached.at < 300000 && typeof cached.state.linked === 'boolean') {
        document.documentElement.dataset.agarukeMembersState = cached.state.linked ? 'linked' : 'unlinked';
      } else if (!cfg.customer_present && !cfg.has_cart_session && !sessionStorage.getItem('agaruke-purchase-v2')) {
        document.documentElement.dataset.agarukeMembersState = 'unlinked';
      }
    } catch (_) {}
  </script>
  <noscript><style>.shopify-section:has(.announcement-bar a[href*="/apps/members"]) { display: block !important; } [data-agaruke-member-card] { visibility: visible !important; }</style></noscript>
  {{ 'agaruke-coupons.css' | asset_url | stylesheet_tag }}
  <script type="module" src="{{ 'agaruke-coupons.js' | asset_url }}"></script>
  <script type="module" src="{{ 'agaruke-members-status.js' | asset_url }}"></script>
  {% if request.page_type == 'product' or request.page_type == 'cart' %}
    <script type="module" src="{{ 'agaruke-benefits.js' | asset_url }}"></script>
  {% endif %}
{% endunless %}
